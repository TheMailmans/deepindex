{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevContext Configuration",
  "description": "Configuration schema for DevContext embeddings and memory bank system",
  "type": "object",
  "required": ["projectName", "projectType", "rootDir", "domains"],
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Display name of your project"
    },
    "projectType": {
      "type": "string",
      "enum": ["rust", "typescript", "javascript", "python", "go", "java", "mixed"],
      "description": "Primary language/framework of the project"
    },
    "rootDir": {
      "type": "string",
      "description": "Absolute path to project root directory"
    },
    "domains": {
      "type": "array",
      "description": "Logical domains/modules in your codebase",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "patterns", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Domain identifier (e.g., 'auth', 'api', 'frontend')",
            "pattern": "^[a-z0-9-]+$"
          },
          "patterns": {
            "type": "array",
            "description": "Glob patterns to match files in this domain",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of this domain"
          }
        }
      }
    },
    "embeddingsModel": {
      "type": "string",
      "default": "nomic-embed-text",
      "description": "Ollama model to use for embeddings generation"
    },
    "chunkSize": {
      "type": "number",
      "default": 512,
      "minimum": 128,
      "maximum": 2048,
      "description": "Maximum tokens per code chunk"
    },
    "tagKeywords": {
      "type": "array",
      "description": "Keywords to extract as tags from code",
      "items": {
        "type": "string"
      }
    }
  }
}
