{
  "name": "devcontext-embeddings",
  "version": "1.0.0",
  "description": "Universal embeddings system for semantic code search - works with any codebase",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "index": "npm run build && node dist/cli.js index",
    "search": "npm run build && node dist/cli.js search",
    "watch": "npm run build && node dist/watcher.js",
    "mcp-server": "npm run build && node dist/mcp-server.js",
    "stats": "node dist/cli.js stats",
    "dev": "tsc --watch"
  },
  "bin": {
    "devcontext-embed": "./dist/cli.js"
  },
  "keywords": [
    "embeddings",
    "code-search",
    "ollama",
    "mcp",
    "semantic-search",
    "rag",
    "devtools",
    "claude",
    "faiss"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "faiss-node": "^0.5.1",
    "glob": "^11.0.0",
    "ollama": "^0.5.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
