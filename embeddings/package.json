{
  "name": "embedcontext",
  "version": "0.1.0",
  "description": "Local-first code indexing + semantic search + MCP tools for Claude",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "index": "npm run build && node dist/cli.js index",
    "search": "npm run build && node dist/cli.js search",
    "watch": "npm run build && node dist/watcher.js",
    "mcp-server": "npm run build && node dist/mcp-server.js",
    "stats": "node dist/cli.js stats",
    "dev": "tsc --watch"
  },
  "bin": {
    "embedcontext": "./dist/cli.js",
    "embedcontext-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "embeddings",
    "code-search",
    "ollama",
    "mcp",
    "semantic-search",
    "rag",
    "devtools",
    "claude",
    "faiss"
  ],
  "author": "Tyler Mailman <themailmaninbox@gmail.com>",
  "license": "MIT",
  "repository": "https://github.com/themailmans/embedcontext",
  "bugs": "https://github.com/themailmans/embedcontext/issues",
  "homepage": "https://github.com/themailmans/embedcontext#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "faiss-node": "^0.5.1",
    "glob": "^11.0.0",
    "ollama": "^0.5.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
